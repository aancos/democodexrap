projection;
strict ( 2 );
use draft;

define behavior for ZDEMO_C_Request alias Request
{
  use create;
  use update;
  use delete;
  use action Approve;
  use action Reject;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use association _Item { create; with draft; }
}

define behavior for ZDEMO_C_RequestItem alias Item
{
  use update;
  use delete;
  use association _Request { with draft; }
}
